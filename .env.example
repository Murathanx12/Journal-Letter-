# =============================================================================
# Journal & Letter — environment variables
#
# Copy to `.env.local` for development and fill in. Never commit a filled-in
# copy: `.env*.local` is gitignored for exactly this reason.
#
# Note what is NOT here: there is no Supabase service-role key. The application
# reads and writes entirely as the signed-in user, so Row Level Security is
# always in force and there is no privileged key that could bypass it.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
#
# Project Settings -> Data API -> Project URL / API keys.
# The publishable key is safe in the browser: every table denies the `anon` role
# and the `authenticated` policies are scoped to book membership.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Site URL (required in production)
#
# Used to build email confirmation links, password-reset links, OAuth redirects
# and invitation URLs. No trailing slash.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset, so
# preview deployments work without extra configuration.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AI proofreading (optional)
#
# When absent, the proofreading feature reports itself as unavailable rather
# than pretending to work. The key is read only on the server; entry text is
# sent to the provider solely when a person explicitly asks for a check.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
PROOFREAD_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Google Docs export (optional)
#
# A SEPARATE OAuth client from the one used for "Continue with Google" sign-in.
# Ordinary sign-in must not ask anybody for access to their Google Drive; these
# credentials are used only when someone chooses "Export to Google Docs".
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/google/callback
# Enable the Google Docs API and the Google Drive API on the project.
# -----------------------------------------------------------------------------
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
