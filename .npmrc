# npm's peer-dependency solver backtracks pathologically on this dependency set
# (Next 16 + ESLint 9/10 + TipTap 3 + the Vitest toolchain) and never terminates.
# Skipping automatic peer resolution makes install deterministic and fast.
# Every peer we actually rely on — notably @tiptap/pm — is listed explicitly in
# package.json, so nothing is silently missing.
legacy-peer-deps=true

# Keep installs quiet and reproducible in CI and on Vercel.
audit=false
fund=false
